# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database"

# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-key-at-least-32-chars-long"

# The base URL of your application (e.g., https://activeai.vercel.app or http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# Secret Key for AES-256-GCM Encryption (Must be exactly 32 bytes/characters long)
# You can generate one with: openssl rand -base64 24
ENCRYPTION_KEY="your-encryption-key-must-be-32-bytes"
